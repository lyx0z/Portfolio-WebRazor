@page "/learning"
@using Portfolio.Web.Services
@inject GitHubService GitHub

<PageTitle>Learn with me | lyx0z</PageTitle>

<section class="learn-page">
    <header class="learn-header">
        <span class="eyebrow">Learn with me</span>
        <h1>Everything I'm <span class="gradient-text">learning</span>, in public.</h1>
        <p>
            Every exercise, every rough draft, every thing that took me three tries.
            All of it lives on GitHub so you can follow the same path, or see where I am right now.
        </p>

        @if (liveLoaded)
        {
            <span class="live-badge">
                <span class="live-dot"></span>
                Live from GitHub
            </span>
        }
    </header>

    @foreach (var track in tracks)
    {
        <div class="track">
            <div class="track-head">
                <h2>@track.Name</h2>
                <span class="track-meta">@track.Meta</span>
            </div>

            <div class="steps">
                @foreach (var repo in track.Repos)
                {
                    var live = Live(repo.Name);

                    <a class="step @(IsCurrent(repo) ? "current" : "")"
                       href="@repo.Url" target="_blank" rel="noopener noreferrer">
                        <div class="step-marker">
                            <span class="step-dot"></span>
                        </div>

                        <div class="step-body">
                            <div class="step-title">
                                <h3>@repo.Name</h3>

                                @if (IsCurrent(repo))
                                {
                                    <span class="badge-current">Currently here</span>
                                }

                                @if (live?.LastPushedText is not null)
                                {
                                    <span class="badge-updated">updated @live.LastPushedText</span>
                                }
                            </div>

                            <p>@repo.Summary</p>

                            <div class="tags">
                                @if (live?.Language is not null)
                                {
                                    <span class="tag tag-strong">@live.Language</span>
                                }

                                @foreach (var topic in repo.Topics)
                                {
                                    <span class="tag">@topic</span>
                                }
                            </div>
                        </div>

                        <span class="step-arrow">↗</span>
                    </a>
                }
            </div>
        </div>
    }

    <div class="learn-cta">
        <p>Everything I write is public. Follow along or steal whatever is useful.</p>
        <a class="btn btn-accent" href="https://github.com/lyx0z" target="_blank" rel="noopener noreferrer">
            All repos on GitHub
        </a>
    </div>
</section>

@code {
    // Curated content. GitHub has no descriptions or topics set on these repos,
    // so the prose has to live here. Name must match the GitHub repo name
    // exactly, that string is the join key between this list and the API.
    private record Repo(
        string Name,
        string Summary,
        string Url,
        string[] Topics,
        bool IsCurrentFallback = false
    );

    private record Track(string Name, string Meta, Repo[] Repos);

    // Live data, keyed by repo name. Empty until the fetch returns, and stays
    // empty if the fetch fails, which is why every use of it is null checked.
    private Dictionary<string, GitHubRepo> liveRepos = new(StringComparer.OrdinalIgnoreCase);

    private bool liveLoaded;

    // Name of whichever tracked repo was pushed to most recently.
    private string? mostRecentlyPushed;

    protected override async Task OnInitializedAsync()
    {
        var repos = await GitHub.GetReposAsync();

        if (repos.Count == 0)
        {
            return; // offline or rate limited, the static content still renders
        }

        liveRepos = repos
            .GroupBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        // Only consider repos that appear on this page, so pushing to an
        // unrelated repo does not move the "Currently here" marker.
        var tracked = tracks.SelectMany(t => t.Repos).Select(r => r.Name);

        mostRecentlyPushed = tracked
            .Select(Live)
            .Where(r => r?.PushedAt is not null)
            .OrderByDescending(r => r!.PushedAt)
            .FirstOrDefault()
            ?.Name;

        liveLoaded = true;
    }

    private GitHubRepo? Live(string name) =>
        liveRepos.TryGetValue(name, out var repo) ? repo : null;

    // Derived from the API when we have it, falls back to the hand set flag
    // when we don't, so the page never looks broken offline.
    private bool IsCurrent(Repo repo) =>
        mostRecentlyPushed is not null
            ? string.Equals(mostRecentlyPushed, repo.Name, StringComparison.OrdinalIgnoreCase)
            : repo.IsCurrentFallback;

    private readonly Track[] tracks =
    [
        new Track("C#", "Three repos, in order", [
            new Repo(
                "Cs-Basics",
                "Where I started. The compiler, first programs, operators, loops, arrays, a first look at OOP, and a set of debugging exercises to get used to reading errors instead of fearing them.",
                "https://github.com/lyx0z/Cs-Basics",
                ["First steps", "Operators", "Loops", "Arrays", "OOP", "Debugging"]
            ),
            new Repo(
                "Cs-Intermediate",
                "Past the syntax stage. Building bigger exercises where the structure of the code starts to matter as much as whether it runs.",
                "https://github.com/lyx0z/Cs-Intermediate",
                ["Exercises"]
            ),
            new Repo(
                "Cs-Advanced",
                "Collections, which is the first topic where picking the wrong tool actually costs you something.",
                "https://github.com/lyx0z/Cs-Advanced",
                ["Collections"],
                IsCurrentFallback: true
            )
        ]),

        new Track("Rust", "Just getting started", [
            new Repo(
                "Rust-Basics",
                "A Cargo workspace I use to follow the Rust book. Hello World and the guessing game so far. Coming from C#, the borrow checker is the part that keeps humbling me.",
                "https://github.com/lyx0z/Rust-Basics",
                ["Cargo", "Hello World", "Guessing game"]
            )
        ]),

        new Track("Projects I built to learn", "Not exercises, actual programs", [
            new Repo(
                "Notepad",
                "A text editor in C#. The file handling lives in its own FileUtils project, which was my first go at splitting logic out of the app that uses it.",
                "https://github.com/lyx0z/Notepad",
                ["File IO", "Multi project solution"]
            ),
            new Repo(
                "GameOfLife",
                "Conway's Game of Life with a console front end and a web front end sharing one engine. Taught me how to keep rules and rendering apart, and how unit tests make that pay off.",
                "https://github.com/lyx0z/GameOfLife",
                ["Blazor WebAssembly", "NUnit"]
            ),
            new Repo(
                "Portfolio-WebRazor",
                "This site. Blazor WebAssembly, hand written CSS, no component library, deployed from a GitHub Action. The page you are reading pulls its own data from the GitHub API.",
                "https://github.com/lyx0z/Portfolio-WebRazor",
                ["Blazor WebAssembly", "CSS", "GitHub Actions"]
            )
        ])
    ];
}
